# Set index.html as default landing page (MUST BE FIRST)
DirectoryIndex index.html

# Enable PHP error reporting (disable in production)
php_flag display_errors on
php_value error_reporting E_ALL

# Security settings
<Files "config.php">
    Order allow,deny
    Deny from all
</Files>

<Files "database-setup.sql">
    Order allow,deny
    Deny from all
</Files>
